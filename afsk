// Быстрая отправка частоты в AD9851 внутри прерывания (без delayMicroseconds)
void IRAM_ATTR setFrequencyISR(uint32_t frequency) {
  [span_80](start_span)uint32_t freq_word = (frequency * 4294967296ULL) / REF_CLOCK;[span_80](end_span)
  
  // Аппаратный ногодрыг через регистры ESP32 (быстрее и безопаснее в ISR)
  REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_FQ_UD));
  
  for (int i = 0; i < 32; i++) {
    if ((freq_word >> i) & 0x01) {
      REG_WRITE(GPIO_OUT_W1TS_REG, (1 << PIN_DATA));
    } else {
      REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_DATA));
    }
    REG_WRITE(GPIO_OUT_W1TS_REG, (1 << PIN_W_CLK));
    REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_W_CLK));
  }
  
  REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_DATA));
  for (int i = 0; i < 8; i++) {
    REG_WRITE(GPIO_OUT_W1TS_REG, (1 << PIN_W_CLK));
    REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_W_CLK));
  }
  
  REG_WRITE(GPIO_OUT_W1TS_REG, (1 << PIN_FQ_UD));
  REG_WRITE(GPIO_OUT_W1TC_REG, (1 << PIN_FQ_UD));
}

// Обработчик аппаратного прерывания таймера
static bool IRAM_ATTR on_tx_timer_cb(gptimer_handle_t timer, const gptimer_alarm_event_data_t *edata, void *user_ctx) {
  if (tx_bit_r_idx != tx_bit_w_idx) {
    bool bit_to_send = tx_bit_buffer[tx_bit_r_idx];
    tx_bit_r_idx = (tx_bit_r_idx + 1) % BIT_BUF_SIZE;
    
    setFrequencyISR(bit_to_send ? MARK_FREQ : SPACE_FREQ);
  } else {
    // Буфер пуст, останавливаем модулирование
    tx_is_active = false;
    gptimer_stop(timer);
    setFrequencyISR(0); 
  }
  return false;
}

void init_tx_timer() {
  gptimer_config_t timer_config = {
    .clk_src = GPTIMER_CLK_SRC_DEFAULT,
    .direction = GPTIMER_COUNT_UP,
    .resolution_hz = 1000000, // 1 мкс разрешение
  };
  ESP_ERROR_CHECK(gptimer_new_timer(&timer_config, &tx_timer));

  gptimer_alarm_config_t alarm_config = {
    .alarm_count = BIT_DURATION_US, // Длительность 1 бита в мкс (20000 мкс для 50 Бод)
    .reload_count = 0,
    .flags = { .auto_reload = true }
  };
  ESP_ERROR_CHECK(gptimer_set_alarm_action(tx_timer, &alarm_config));

  gptimer_event_callbacks_t cbs = { .on_alarm = on_tx_timer_cb };
  ESP_ERROR_CHECK(gptimer_register_event_callbacks(tx_timer, &cbs, NULL));
  ESP_ERROR_CHECK(gptimer_enable(tx_timer));
}

// Безопасное добавление бита в кольцевой буфер
void push_tx_bit(bool bit) {
  int next_w_idx = (tx_bit_w_idx + 1) % BIT_BUF_SIZE;
  if (next_w_idx != tx_bit_r_idx) {
    tx_bit_buffer[tx_bit_w_idx] = bit;
    tx_bit_w_idx = next_w_idx;
  }
}

// Нарезка и упаковка кадра в кольцевой буфер битов
