  [span_82](start_span)size_t len = strlen(message);[span_82](end_span)
  [span_83](start_span)for (size_t i = 0; i < len; i++) {[span_83](end_span)
    [span_84](start_span)uint8_t data = message[i];[span_84](end_span)
    push_tx_bit(0); // Старт-бит
    [span_85](start_span)for (int b = 0; b < 8; b++) push_tx_bit((data >> b) & 0x01);[span_85](end_span)
    push_tx_bit(1); // Стоп-бит
  }
  
  // 3. Контрольная сумма CRC-8 (Старт + 8 бит LSB + Стоп)
  [span_86](start_span)uint8_t crc = crc8((const uint8_t*)message, len);[span_86](end_span)
  push_tx_bit(0); // Старт-бит
  for (int b = 0; b < 8; b++) push_tx_bit((crc >> b) & 0x01);
  push_tx_bit(1); // Стоп-бит
  
  // 4. Постамбула / Хвост кадра
  [span_87](start_span)for (int i = 0; i < 10; i++) push_tx_bit(1);[span_87](end_span)
  
  // Активируем таймер, если он спал
  if (!tx_is_active) {
    tx_is_active = true;
    gptimer_start(tx_timer);
  }
}

